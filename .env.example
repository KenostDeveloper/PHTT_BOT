# ---- Telegram ----
# Токен бота от @BotFather
BOT_TOKEN=

# Чаты/каналы для рассылки (можно указать один и тот же id для теста)
CHAT_ID_CORPUS_1=
CHAT_ID_CORPUS_2=
CHAT_ID_CORPUS_3=

# Публичные каналы корпусов — подставляются в подпись «Другие корпуса»
CHANNEL_CORPUS_1=@phttgroup
CHANNEL_CORPUS_2=@phttoff
CHANNEL_CORPUS_3=@permphtt

# ---- Подпись ----
ADMIN_USERNAME=@kenostdev
FALLBACK_URL=https://t.me/vitehubbot?startapp=gifts_16dd2850-6998-42f1-a788-b0c57dc0fdc2

# ---- Источник ----
SCHEDULE_URL=https://phtt.ru/raspisanie_zanyatiy/
SITE_ORIGIN=https://phtt.ru

# ---- Расписание проверок ----
CHECK_CRON=*/1 * * * *
CHECK_ON_START=true
# Разослать всё при первом запуске, когда локальной истории ещё нет
SEND_ON_FIRST_RUN=false

# ---- Качество картинок ----
# Ширина итогового PNG. 2560 — максимум, который Telegram хранит для фото
IMAGE_WIDTH=2560
# DPI черновой отрисовки для поиска полей
PROBE_DPI=30
# Белое поле вокруг содержимого, доля страницы
IMAGE_PADDING=0.012

# ---- Прочее ----
PORT=5555
HOST=127.0.0.1
# Каталог с бинарниками poppler. Пусто — определяется автоматически
# (Linux: /usr/bin, macOS/brew: /usr/local/bin или /opt/homebrew/bin)
POPPLER_PATH=
STATE_DIR=./info
PDF_DIR=./Rasp
ENABLE_POLLING=false
HTTP_TIMEOUT=20000
SEND_RETRIES=3
